# kiralearn.space deploy repo — allowlist model
# Everything is ignored by default. Only deploy-shaped files are tracked.
# This keeps personal notes, transcripts, and action logs out of the public repo.

# Ignore everything
/*
/**

# Allowlist deploy files & folders
!/.gitignore
!/.gitattributes
!/.nojekyll
!/CNAME
!/README.md
!/DESIGN.md
!/index.html
!/build-index.js
!/package.json
!/package-lock.json

!/articles/
!/articles/**

!/sharp/
!/sharp/**

!/favicon.svg
!/robots.txt

!/docs/
!/docs/**

!/lib/
!/lib/**

!/tests/
!/tests/**

# Inside allowlisted folders, still ignore noise
**/.DS_Store
**/node_modules/
**/.vercel/
**/*.log
.vercel
