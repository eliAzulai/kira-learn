{
  "name": "kiralearn",
  "version": "1.0.0",
  "description": "Static site for kiralearn.space — generated from /kira-learn skill output",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:og": "node tools/gen-og-image.mjs",
    "build": "node tools/gen-og-image.mjs && node build-index.js",
    "test": "node --test 'tests/*.test.js'",
    "lint:styles": "stylelint dist/index.html --config stylelint.config.mjs",
    "lint:html": "node tools/check-rendered-html-quality.mjs",
    "lint": "npm run lint:styles && npm run lint:html"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.11.0"
  }
}
