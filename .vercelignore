# Mirror the .gitignore allowlist for Vercel's bundler.
# Vercel does NOT honor .gitignore — without this file, all the
# personal notes alongside this project would get uploaded to the deploy.
#
# Strategy: ignore everything by default, then allowlist deploy-shaped paths.

# Ignore everything
/*
/**

# Allowlist deploy files
!/index.html
!/sharp.html
!/favicon.svg
!/robots.txt
!/vercel.json
!/package.json
!/package-lock.json

# Allowlist deploy folders
!/articles/
!/articles/**

# Build script + libs (Vercel build runs `npm run build` which executes them)
!/build-index.js
!/lib/
!/lib/**

# Inside allowlisted folders, still ignore noise
**/.DS_Store
**/node_modules/
**/.vercel/
**/*.log

# Explicitly exclude things Vercel might otherwise pick up
.claude/
.git/
docs/
tests/
DESIGN.md
README.md
